POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Used to sign login tokens. Has a dev default in code but should be
# overridden with a random value for anything beyond local development.
# Production: set a long random value (`openssl rand -hex 32`)
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Object storage. The endpoint is embedded in presigned URLs, so it has to be
# reachable from the browser, not just from the API.
# On the VPS: the public address of this server, e.g. 203.0.113.10:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=classroom-materials
MINIO_SECURE=false
